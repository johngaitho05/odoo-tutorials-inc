<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="awesome_dashboard.NumberCard">
        <p class="text-center" t-esc="props.title"/>
        <h2 style="color: green;text-align: center; font-size: 26px" t-esc="props.value"/>
    </t>

    <t t-name="awesome_dashboard.PieChartCard">
        <PieChart data="props.data"/>
    </t>

    <t t-name="awesome_dashboard.AwesomeDashboard">
        <Layout display="{ controlPanel: {} }" className="'o_dashboard h-100'">
            <t t-set-slot="layout-buttons">
                <div class="d-inline-flex gap-1">
                    <button t-on-click="openCustomers" type="button" class="btn btn-primary" title="Customers">Customers</button>
                    <button t-on-click="openLeads" type="button" class="btn btn-primary ml-2" title="Leads">Leads</button>
                </div>
            </t>

            <div class="d-flex vertical-baseline flex-wrap">
                <t t-foreach="items" t-as="item" t-key="item.id">
                    <DashboardItem size="item.size || 1">
                        <t t-set="itemProp" t-value="item.props ? item.props(statistics) : {'data': statistics}"/>
                        <t t-component="item.Component" t-props="itemProp" />
                    </DashboardItem>
                </t>
            </div>
        </Layout>
    </t>

</templates>
