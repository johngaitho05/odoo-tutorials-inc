<?xml version="1.0" encoding="UTF-8" ?>
<templates>

    <t t-name="awesome_owl.playground">
        <div class="p-3 d-flex justify-content-start gap-5 align-items-center">
            <Counter onChange.bind="incrementSum"/>
            <Counter onChange.bind="incrementSum"/>
            <div><p class="mb-0">Total: <t t-esc="state.sum"/></p></div>
        </div>
        <div class="mt-4">
            <t t-foreach="this.cards" t-as="card" t-key="card_index">
                <Card title="card.title" content="card.content"/>
            </t>
        </div>
        <div class="card d-inline-block m-2">
            <div class="card-body">
                <TodoList/>
            </div>
        </div>
        <br/>
        <div class="card d-inline-block m-2">
            <div class="card-body">
                <SlotCard title="'Counter Card'">
                    <Counter onChange.bind="incrementSum"/>
                </SlotCard>
            </div>
        </div>

    </t>

</templates>
