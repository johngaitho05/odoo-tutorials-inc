<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="awesome_owl.SlotCard">
        <div class="card d-inline-block m-2" style="width: 18rem;">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <h5 class="card-title"><t t-esc="props.title"/></h5>
                    <p class="d-inline-block ml-4 cursor-pointer text-sm font-weight-light" t-on-click="toggleContent">Toggle</p>
                </div>
                <t t-if="state.visible" t-slot="default"/>
            </div>
        </div>
    </t>
</templates>
