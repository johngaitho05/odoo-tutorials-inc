<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="awesome_owl.Card">
        <div class="card d-inline-block m-2" style="width: 18rem;">
            <div class="card-body">
                <h5 class="card-title"><t t-esc="props.title"/></h5>
                <div class="card-text">
                    <t t-out="props.content"></t>
                </div>
            </div>
        </div>
    </t>
</templates>
