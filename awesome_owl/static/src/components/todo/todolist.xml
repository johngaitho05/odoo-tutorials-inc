<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="awesome_owl.TodoList">
        <div class="card d-inline-block m-2">
            <div class="card-body">
                <input class="form-control mb-4" t-on-keyup="addTodo" t-ref="input" placeholder="Add a todo"/>
                <t t-foreach="this.todos" t-as="todo" t-key="todo.id">
                    <TodoItem todo="todo" change.bind="toggleState" removeTodo.bind="removeTodo"/>
                </t>
            </div>
        </div>
    </t>
</templates>
